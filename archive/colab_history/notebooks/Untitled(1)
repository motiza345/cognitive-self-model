 dict): return {str(k): to_jsonable(v) for k, v in obj.items()}\n","    if isinstance(obj, (list, tuple)): return [to_jsonable(v) for v in obj]\n","    if isinstance(obj, np.ndarray): return obj.tolist()\n","    if isinstance(obj, np.generic): return obj.item()\n","    if isinstance(obj, torch.Tensor): return obj.item() if obj.ndim == 0 else obj.detach().cpu().tolist()\n","    if isinstance(obj, (str, int, float, bool)) or obj is None: return obj\n","    if hasattr(obj, \"__dataclass_fields__\"): return to_jsonable(asdict(obj))\n","    return str(obj)\n","\n","\n","def extract_context_family(ctx_str: str) -> str:\n","    for prefix in [\"train_\", \"calib_\", \"test_\", \"ood_\"]:\n","        if ctx_str.startswith(prefix): return ctx_str[len(prefix):]\n","    return ctx_str\n","\n","\n","# ==============================================================================\n","# 1. UTILITY MATRIX & GOVERNANCE ONTOLOGY\n","# ==============================================================================\n","\n","class DecoupledUtility:\n","    THRESH_GAIN = 0.005\n","    THRESH_HAZARD = -0.05\n","    ALL_ACTIONS = [\"APPROVED\", \"VETO_ZERO_GAIN\", \"VETO_HAZARD\", \"VETO_EPISTEMIC\"]\n","\n","    @staticmethod\n","    def get_utility(action: str, delta_m: float) -> float:\n","        if delta_m >= DecoupledUtility.THRESH_GAIN:\n","            if action == \"APPROVED\": return float(delta_m)\n","            if action == \"VETO_EPISTEMIC\": return -0.005  # هزینه فرصت ناشی از شک\n","            if action == \"VETO_ZERO_GAIN\": return -0.015\n","            if action == \"VETO_HAZARD\": return -0.03\n","        elif delta_m < DecoupledUtility.THRESH_HAZARD:\n","            if action == \"VETO_HAZARD\": return 0.05      # پاداش شناخت مانع\n","            if action == \"VETO_EPISTEMIC\": return 0.03    # پاداش احتیاط موجه\n","            if action == \"VETO_ZERO_GAIN\": return 0.01\n","            if action == \"APPROVED\": return float(10.0 * delta_m)  # جریمه سنگین فاجعه\n","        else:\n","            if action == \"VETO_ZERO_GAIN\": return 0.005\n","            if action == \"VETO_EPISTEMIC\": return 0.002\n","            if action == \"VETO_HAZARD\": return 0.0\n","            if action == \"APPROVED\": return float(delta_m)\n","        return -1.0\n","\n","    @staticmethod\n","    def get_omniscient_oracle(delta_m: float) -> Tuple[str, float]:\n","        utils = [DecoupledUtility.get_utility(a, delta_m) for a in DecoupledUtility.ALL_ACTIONS]\n","        best_idx = int(np.argmax(utils))\n","        return DecoupledUtility.ALL_ACTIONS[best_idx], utils[best_idx]\n","\n","\n","# ==============================================================================\n","# 2. BAYESIAN SCM WITH EXTRAPOLATION PENALTY & RESIDUAL DECOUPLING\n","# ==============================================================================\n","\n","@dataclass\n","class TargetSpec:\n","    layer: int\n","    component: str\n","    index: int = 0\n","    keep_ratio: float = 0.0\n","\n","    @property\n","    def dose(self) -> float:\n","        return float(np.clip(1.0 - self.keep_ratio, 0.0, 1.0))\n","\n","    @property\n","    def key(self) -> str:\n","        return f\"L{self.layer}_{self.component}_{self.index}\"\n","\n","\n","@dataclass\n","class PromptItem:\n","    prompt: str\n","    target_str: str\n","    distractor_str: str\n","\n","\n","class RigorousBayesianSelfGraph:\n","    def __init__(self, prior_variance: float = 0.5, base_aleatoric: float = 0.005, extrap_penalty_gamma: float = 1.5):\n","        self.prior_variance = prior_variance\n","        self.base_aleatoric = base_aleatoric\n","        self.gamma = extrap_penalty_gamma\n","        self.component_models: Dict[str, Dict[str, Dict[str, Any]]] = {}\n","\n","    def init_node(self, target_key: str, ctx_str: str):\n","        family = extract_context_family(ctx_str)\n","        if target_key not in self.component_models:\n","            self.component_models[target_key] = {}\n","        if family not in self.component_models[target_key]:\n","            self.component_models[target_key][family] = {\n","                \"mu\": np.zeros(2),\n","                \"precision\": np.eye(2) / self.prior_variance,\n","                \"cov\": np.eye(2) * self.prior_variance,\n","                \"aleatoric_var\": self.base_aleatoric,\n","                \"history\": [],\n","                \"max_dose_probed\": 0.0,\n","                \"n\": 0\n","            }\n","\n","    def update(self, target_key: str, ctx_str: str, dose: float, delta_obs: float):\n","        family = extract_context_family(ctx_str)\n","        self.init_node(target_key, ctx_str)\n","        node = self.component_models[target_key][family]\n","\n","        x = np.array([dose, dose**2])\n","        node[\"history\"].append((dose, delta_obs))\n","        node[\"max_dose_probed\"] = max(node[\"max_dose_probed\"], dose)\n","\n","        # تفکیک آلاتوریک: تخمین واریانس شرطی نویز از تفاضل‌های متوالی برای حذف خطای رگرسیون\n","        if len(node[\"history\"]) >= 3:\n","            y_vals = np.array([h[1] for h in node[\"history\"]])\n","            diffs = np.diff(y_vals)\n","            est_noise_var = float(0.5 * np.mean(diffs**2))\n","            node[\"aleatoric_var\"] = max(self.base_aleatoric, est_noise_var)\n","\n","        inv_noise = 1.0 / max(node[\"aleatoric_var\"], 1e-6)\n","        prec_old = node[\"precision\"]\n","        mu_old = node[\"mu\"]\n","\n","        prec_new = prec_old + inv_noise * np.outer(x, x)\n","        cov_new = np.linalg.inv(prec_new)\n","        mu_new = cov_new @ (prec_old @ mu_old + inv_noise * x * delta_obs)\n","\n","        node[\"precision\"] = prec_new\n","        node[\"cov\"] = cov_new\n","        node[\"mu\"] = mu_new\n","        node[\"n\"] += 1\n","\n","    def predict(self, targets: List[TargetSpec], ctx_str: str) -> Tuple[float, float, float, float]:\n","        family = extract_context_family(ctx_str)\n","        pred_delta = 0.0\n","        epi_var = 0.0\n","        ale_var = 0.0\n","\n","        for t in targets:\n","            if t.dose == 0.0: continue\n","            x = np.array([t.dose, t.dose**2])\n","            self.init_node(t.key, ctx_str)\n","            node = self.component_models[t.key][family]\n","            pred_delta += float(x @ node[\"mu\"])\n","\n","            raw_epi = float(x @ node[\"cov\"] @ x)\n","            # جریمه برون‌یابی: تورم واقع‌گرایانه واریانس معرفتی هنگام پرتاب به دوزهای دورتر از سقف پروب\n","            d_max = max(node[\"max_dose_probed\"], 0.1)\n","            extrap_factor = 1.0 + self.gamma * (max(0.0, (t.dose - d_max) / d_max) ** 2)\n","            epi_var += raw_epi * extrap_factor\n","            ale_var += float(node[\"aleatoric_var\"])\n","\n","        total_pred_var = epi_var + ale_var\n","        return pred_delta, float(np.sqrt(total_pred_var)), float(np.sqrt(epi_var)), float(np.sqrt(ale_var))\n","\n","\n","# ==============================================================================\n","# 3. EMPIRICAL TWO-TIER CALIBRATOR (MEMORY-TRAINED ON REAL OUTCOMES)\n","# ==============================================================================\n","\n","class EmpiricalOutcomeCalibrator:\n","    \"\"\"\n","    کالیبراتور مبتنی بر حافظه که منحصراً روی سوابق پیش‌بینی و برآیند فیزیکی واقعی مدل آموزش می‌بیند\n","    \"\"\"\n","    def __init__(self):\n","        self.model = LogisticRegression(multi_class=\"multinomial\", solver=\"lbfgs\", max_iter=200, C=1.0)\n","        self.is_fitted = False\n","        self.feature_records: List[np.ndarray] = []\n","        self.label_records: List[int] = []\n","\n","    @staticmethod\n","    def extract_features(mu: float, sig_pred: float, sig_epi: float, sig_ale: float) -> np.ndarray:\n","        sig_pred = max(sig_pred, 1e-6)\n","        z_gain = (mu - DecoupledUtility.THRESH_GAIN) / sig_pred\n","        z_hazard = (DecoupledUtility.THRESH_HAZARD - mu) / sig_pred\n","        return np.array([mu, sig_pred, sig_epi, sig_ale, z_gain, z_hazard])\n","\n","    def store_memory(self, mu: float, sig_pred: float, sig_epi: float, sig_ale: float, true_delta: float):\n","        feats = self.extract_features(mu, sig_pred, sig_epi, sig_ale)\n","        if true_delta >= DecoupledUtility.THRESH_GAIN: y = 0\n","        elif true_delta < DecoupledUtility.THRESH_HAZARD: y = 2\n","        else: y = 1\n","        self.feature_records.append(feats)\n","        self.label_records.append(y)\n","\n","    def train_on_memory(self):\n","        if len(set(self.label_records)) < 2 or len(self.label_records) < 5:\n","            self.is_fitted = False\n","            return False\n","        X = np.array(self.feature_records)\n","        y = np.array(self.label_records)\n","        self.model.fit(X, y)\n","        self.is_fitted = True\n","        return True\n","\n","    def predict_beliefs(self, mu: float, sig_pred: float, sig_epi: float, sig_ale: float) -> Dict[str, float]:\n","        sig_pred = max(sig_pred, 1e-6)\n","        if not self.is_fitted:\n","            # فال‌بک تحلیلی در صورت نبود داده حافظه تجربی کافی\n","            p_haz = float(norm.cdf((DecoupledUtility.THRESH_HAZARD - mu) / sig_pred))\n","            p_gain = float(1.0 - norm.cdf((DecoupledUtility.THRESH_GAIN - mu) / sig_pred))\n","            p_zero = max(0.0, 1.0 - p_haz - p_gain)\n","            return {\"P_gain\": p_gain, \"P_zero\": p_zero, \"P_hazard\": p_haz}\n","\n","        feats = self.extract_features(mu, sig_pred, sig_epi, sig_ale).reshape(1, -1)\n","        probs = self.model.predict_proba(feats)[0]\n","        classes = self.model.classes_\n","        p_gain = float(probs[np.where(classes == 0)[0][0]]) if 0 in classes else 0.0\n","        p_zero = float(probs[np.where(classes == 1)[0][0]]) if 1 in classes else 0.0\n","        p_hazard = float(probs[np.where(classes == 2)[0][0]]) if 2 in classes else 0.0\n","\n","        # نرمال‌سازی مجدد\n","        total_p = p_gain + p_zero + p_hazard\n","        if total_p <= 0: total_p = 1.0\n","        return {\"P_gain\": p_gain / total_p, \"P_zero\": p_zero / total_p, \"P_hazard\": p_hazard / total_p}\n","\n","\n","# ==============================================================================\n","# 4. MECHANISTIC SENSORS INTERFACE\n","# ==============================================================================\n","\n","class MechanisticSensorInterface:\n","    def __init__(self, model_name: str = MODEL_NAME, device: str = \"cuda\"):\n","        self.device = device if torch.cuda.is_available() else \"cpu\"\n","        print(f\"🔄 Initializing Sensors ({model_name}) on {self.device.upper()}...\")\n","        self.model = HookedTransformer.from_pretrained(\n","            model_name, device=self.device, torch_dtype=torch.float32, default_padding_side=\"left\"\n","        )\n","        self.model.eval()\n","        for p in self.model.parameters(): p.requires_grad_(False)\n","\n","    def _build_hooks(self, targets: List[TargetSpec]):\n","        hooks = []\n","        for t in targets:\n","            keep = t.keep_ratio\n","            if t.component == \"head\":\n","                h_idx = t.index\n","                def head_hook_fn(act, hook, h=h_idx, r=keep):\n","                    act[:, -1, h, :] = act[:, -1, h, :] * r\n","                    return act\n","                hooks.append((f\"blocks.{t.layer}.attn.hook_z\", head_hook_fn))\n","            elif t.component == \"mlp\":\n","                def mlp_hook_fn(act, hook, r=keep):\n","                    act[:, -1, :] = act[:, -1, :] * r\n","                    return act\n","                hooks.append((f\"blocks.{t.layer}.hook_mlp_out\", mlp_hook_fn))\n","        return hooks\n","\n","    def _resolve_token_id(self, token_str: str) -> int:\n","        toks = self.model.to_tokens(token_str, prepend_bos=False)[0]\n","        return int(toks[-1].item())\n","\n","    @torch.no_grad()\n","    def measure_grounded_outcomes(\n","        self, items: List[PromptItem], targets: Optional[List[TargetSpec]] = None, noise_sigma: float = 0.0\n","    ) -> float:\n","        prompts = [it.prompt for it in items]\n","        tokens = self.model.to_tokens(prompts)\n","        batch_size = len(items)\n","        b_idx = torch.arange(batch_size, device=self.device)\n","\n","        target_ids = torch.tensor([self._resolve_token_id(it.target_str) for it in items], device=self.device)\n","        distractor_ids = torch.tensor([self._resolve_token_id(it.distractor_str) for it in items], device=self.device)\n","\n","        clean_logits = self.model(tokens)[:, -1, :].float()\n","        clean_m = clean_logits[b_idx, target_ids] - clean_logits[b_idx, distractor_ids]\n","\n","        if not targets: return 0.0\n","\n","        with self.model.hooks(fwd_hooks=self._build_hooks(targets)):\n","            int_logits = self.model(tokens)[:, -1, :].float()\n","\n","        int_m = int_logits[b_idx, target_ids] - int_logits[b_idx, distractor_ids]\n","        raw_delta = float(torch.mean(int_m - clean_m).item())\n","\n","        if noise_sigma > 0.0:\n","            return raw_delta + float(np.random.normal(0.0, noise_sigma))\n","        return raw_delta\n","\n","\n","# ==============================================================================\n","# 5. THREE-TIER ENGINE: MONITOR -> PROBER -> GOVERNOR\n","# ==============================================================================\n","\n","class ThreeTierEpistemicEngine:\n","    def __init__(self, scm: RigorousBayesianSelfGraph, calibrator: EmpiricalOutcomeCalibrator,\n","                 lambda_risk: float = 1.0, cost_factor: float = 0.005):\n","        self.scm = scm\n","        self.calibrator = calibrator\n","        self.lambda_risk = lambda_risk\n","        self.cost_factor = cost_factor\n","        self.candidates = np.linspace(0.05, 0.40, 8)\n","        self.eval_shifts = np.array([-2.0, -1.5, -1.0, -0.5, 0.0, 0.5, 1.0, 1.5, 2.0])\n","        self.eval_weights = norm.pdf(self.eval_shifts)\n","        self.eval_weights /= np.sum(self.eval_weights)\n","\n","    def _evaluate_max_expected_utility(self, mu_star: float, sigma_star: float) -> float:\n","        sigma_star = max(sigma_star, 1e-6)\n","        samples = mu_star + sigma_star * self.eval_shifts\n","        action_expected_utils = []\n","        for a in DecoupledUtility.ALL_ACTIONS:\n","            eu_a = sum(w * DecoupledUtility.get_utility(a, s) for w, s in zip(self.eval_weights, samples))\n","            action_expected_utils.append(eu_a)\n","        return float(max(action_expected_utils))\n","\n","    def evaluate_step(\n","        self, target: TargetSpec, ctx_str: str, executed_doses: List[float]\n","    ) -> Tuple[float, bool, str, str, Dict[str, float]]:\n","        self.scm.init_node(target.key, ctx_str)\n","        node = self.scm.component_models[target.key][extract_context_family(ctx_str)]\n","\n","        x_full = np.array([1.0, 1.0])\n","        mu_full = float(x_full @ node[\"mu\"])\n","        pred_mu, sig_pred, sig_epi, sig_ale = self.scm.predict([target], ctx_str)\n","\n","        beliefs = self.calibrator.predict_beliefs(pred_mu, sig_pred, sig_epi, sig_ale)\n","\n","        # ۱. لایه پایش شناخت (Knowledge Monitor)\n","        epistemic_state = \"EPISTEMICALLY_UNCERTAIN\"\n","        if beliefs[\"P_hazard\"] >= 0.65:\n","            epistemic_state = \"CONFIDENT_HAZARD\"\n","        elif beliefs[\"P_gain\"] >= 0.65:\n","            epistemic_state = \"CONFIDENT_GAIN\"\n","        elif beliefs[\"P_zero\"] >= 0.65:\n","            epistemic_state = \"CONFIDENT_ZERO_GAIN\"\n","\n","        # توقف در صورت احراز اطمینان پس از پروبینگ حداقلی\n","        if len(executed_doses) >= 1 and epistemic_state != \"EPISTEMICALLY_UNCERTAIN\":\n","            return 0.0, True, epistemic_state, f\"STOP_{epistemic_state}\", beliefs\n","\n","        # ۲. لایه اقتصاد پروبینگ (Economic Prober)\n","        current_v = self._evaluate_max_expected_utility(mu_full, sig_pred)\n","        best_net_score = -float(\"inf\")\n","        best_dose = self.candidates[0]\n","\n","        pts, wts = np.polynomial.hermite.hermgauss(5)\n","\n","        for d in self.candidates:\n","            if any(abs(d - ed) < 0.03 for ed in executed_doses): continue\n","            x_d = np.array([d, d**2])\n","            pred_y = float(x_d @ node[\"mu\"])\n","            std_y = np.sqrt(float(x_d @ node[\"cov\"] @ x_d) + node[\"aleatoric_var\"])\n","\n","            prec_sim = node[\"precision\"] + (1.0 / node[\"aleatoric_var\"]) * np.outer(x_d, x_d)\n","            cov_sim = np.linalg.inv(prec_sim)\n","            epi_sim = float(x_full @ cov_sim @ x_full)\n","            sig_pred_sim = float(np.sqrt(epi_sim + node[\"aleatoric_var\"]))\n","\n","            expected_posterior_v = 0.0\n","            expected_harm = 0.0\n","            for pt, w in zip(pts, wts):\n","                y_sample = pred_y + np.sqrt(2.0) * std_y * pt\n","                mu_sim = cov_sim @ (node[\"precision\"] @ node[\"mu\"] + (1.0 / node[\"aleatoric_var\"]) * x_d * y_sample)\n","                mu_full_sim = float(x_full @ mu_sim)\n","                expected_posterior_v += (w / np.sqrt(np.pi)) * self._evaluate_max_expected_utility(mu_full_sim, sig_pred_sim)\n","                expected_harm += (w / np.sqrt(np.pi)) * max(0.0, -y_sample)\n","\n","            evoi = max(0.0, expected_posterior_v - current_v)\n","            net_score = evoi - (self.cost_factor * float(d**2)) - (self.lambda_risk * expected_harm)\n","\n","            if net_score > best_net_score:\n","                best_net_score = net_score\n","                best_dose = float(d)\n","\n","        # توقف صرفاً اقتصادی\n","        if len(executed_doses) >= 2 and best_net_score <= 0.0:\n","            return 0.0, True, epistemic_state, \"STOP_UNECONOMIC\", beliefs\n","\n","        return best_dose, False, epistemic_state, \"CONTINUE_PROBING\", beliefs\n","\n","\n","# ==============================================================================\n","# 6. PROTOCOL BENCHMARK CONTROLLER (MILESTONE 17.13)\n","# ==============================================================================\n","\n","def run_milestone_17_13():\n","    sensors = MechanisticSensorInterface()\n","\n","    corpus = {\n","        \"ood_syntactic_agreement\": [\n","            PromptItem(\"The keys to the cabinet are kept in the\", \" drawer\", \" drawers\"),\n","            PromptItem(\"The books on the wooden table belong to the\", \" library\", \" libraries\"),\n","            PromptItem(\"The pictures of the old palace show the ancient\", \" king\", \" kings\"),\n","            PromptItem(\"The report about the recent discoveries was presented by\", \" researcher\", \" researchers\"),\n","        ],\n","        \"ood_distractor_reasoning\": [\n","            PromptItem(\"While Rome has the Colosseum, the Eiffel Tower stands in\", \" Paris\", \" Rome\"),\n","            PromptItem(\"Even though Madrid is famous, the capital of Germany is\", \" Berlin\", \" Madrid\"),\n","            PromptItem(\"Egypt has pyramids, but the Eiffel Tower was built in the city of\", \" Paris\", \" Cairo\"),\n","        ],\n","        \"train_factual_cap\": [\n","            PromptItem(\"The capital of France is the city of\", \" Paris\", \" Rome\"),\n","            PromptItem(\"The capital of Japan is the bustling city of\", \" Tokyo\", \" Kyoto\"),\n","            PromptItem(\"The official capital city of Germany is\", \" Berlin\", \" Munich\"),\n","            PromptItem(\"The historic capital of Italy is the city of\", \" Rome\", \" Milan\"),\n","        ]\n","    }\n","\n","    # تفکیک دقیق داده‌ها (Protocol Split)\n","    # ۱. گره‌های اکتشاف و حافظه کالیبراسیون (Discovery & Calibration Set)\n","    calibration_pool = [\n","        {\"desc\": \"Calib Hazard MLP (L20)\", \"target\": TargetSpec(20, \"mlp\", 0, keep_ratio=0.0), \"ctx\": \"ood_syntactic_agreement\"},\n","        {\"desc\": \"Calib Positive Head (L22H0)\", \"target\": TargetSpec(22, \"head\", 0, keep_ratio=0.0), \"ctx\": \"train_factual_cap\"},\n","        {\"desc\": \"Calib Mid Head (L8H4)\", \"target\": TargetSpec(8, \"head\", 4, keep_ratio=0.0), \"ctx\": \"ood_syntactic_agreement\"},\n","        {\"desc\": \"Calib Zero Head (L4H0)\", \"target\": TargetSpec(4, \"head\", 0, keep_ratio=0.0), \"ctx\": \"ood_syntactic_agreement\"},\n","        {\"desc\": \"Calib Late Head (L21H2)\", \"target\": TargetSpec(21, \"head\", 2, keep_ratio=0.0), \"ctx\": \"train_factual_cap\"}\n","    ]\n","\n","    # ۲. گره‌های کاملاً نادیده برای ارزیابی نهایی (Held-Out Final OOD Set)\n","    final_ood_eval_suite = [\n","        {\"desc\": \"HeldOut Medium Hazard (L12MLP)\", \"target\": TargetSpec(12, \"mlp\", 0, keep_ratio=0.0), \"ctx\": \"ood_syntactic_agreement\"},\n","        {\"desc\": \"HeldOut Boundary Head (L12H3)\", \"target\": TargetSpec(12, \"head\", 3, keep_ratio=0.0), \"ctx\": \"ood_syntactic_agreement\"},\n","        {\"desc\": \"HeldOut Upstream Head (L2H1)\", \"target\": TargetSpec(2, \"head\", 1, keep_ratio=0.0), \"ctx\": \"ood_syntactic_agreement\"},\n","        {\"desc\": \"HeldOut Useful MLP (L16MLP)\", \"target\": TargetSpec(16, \"mlp\", 0, keep_ratio=0.0), \"ctx\": \"ood_syntactic_agreement\"},\n","        {\"desc\": \"HeldOut Positive Head (L4H0)\", \"target\": TargetSpec(4, \"head\", 0, keep_ratio=0.0), \"ctx\": \"ood_distractor_reasoning\"}\n","    ]\n","\n","    print(\"\\n\" + \"=\" * 195)\n","    print(\"🔬 MILESTONE 17.13: EMPIRICAL CALIBRATION, EXTRAPOLATION AUDIT & SAFE RECOVERY\")\n","    print(\"   Protocol: Phase 1 (Collect Real Memory) -> Phase 2 (Train Empirical Calibrator) -> Phase 3 (Strict Held-Out OOD Test)\")\n","    print(\"=\" * 195)\n","\n","    # --------------------------------------------------------------------------\n","    # فاز ۱ و ۲: پروبینگ گره‌های کالیبراسیون و آموزش کالیبراتور روی رخدادهای تجربی واقعی\n","    # --------------------------------------------------------------------------\n","    print(\"\\n📦 PHASE 1: Harvesting Empirical Memory on Calibration Pool...\")\n","    calibrator = EmpiricalOutcomeCalibrator()\n","\n","    for item in calibration_pool:\n","        target = item[\"target\"]\n","        ctx = item[\"ctx\"]\n","        items = corpus[ctx]\n","        scm = RigorousBayesianSelfGraph(prior_variance=0.5, base_aleatoric=0.005, extrap_penalty_gamma=1.5)\n","\n","        # اجرای پروب‌های آزمایشی\n","        for d in [0.10, 0.20, 0.35]:\n","            probe = TargetSpec(target.layer, target.component, target.index, keep_ratio=1.0 - d)\n","            obs = sensors.measure_grounded_outcomes(items, targets=[probe], noise_sigma=0.005)\n","            scm.update(target.key, ctx, d, obs)\n","\n","        pred_mu, sig_pred, sig_epi, sig_ale = scm.predict([target], ctx)\n","        true_delta = sensors.measure_grounded_outcomes(items, targets=[target], noise_sigma=0.0)\n","        calibrator.store_memory(pred_mu, sig_pred, sig_epi, sig_ale, true_delta)\n","        print(f\"  • Ingested Memory: {target.key:<10} | Pred μ: {pred_mu:+7.4f} | σ_pred: {sig_pred:6.4f} | Ground Truth: {true_delta:+7.4f}\")\n","\n","    trained_ok = calibrator.train_on_memory()\n","    print(f\"📦 PHASE 2: Empirical Calibrator Training Status: {'✅ SUCCESS' if trained_ok else '⚠️ FALLBACK TO GAUSSIAN'}\")\n","\n","    # --------------------------------------------------------------------------\n","    # فاز ۳: ارزیابی نهایی در محیط کاملاً نادیده (Strictly Held-Out Evaluation)\n","    # --------------------------------------------------------------------------\n","    print(\"\\n📦 PHASE 3: Strictly Blind Evaluation on Held-Out OOD Targets...\")\n","    noise_sweep_levels = [0.0, 0.005, 0.010, 0.020, 0.040, 0.080]\n","    emp_prior = np.array([0.40, 0.40, 0.20])\n","\n","    def resolve_governor(mu: float, sigma_pred: float, beliefs: Dict[str, float], stop_reason: str) -> str:\n","        # لایه حاکمیت مستقل: تفکیک امتناع از وتوی ناشی از شناخت\n","        if beliefs[\"P_hazard\"] >= 0.60: return \"VETO_HAZARD\"\n","        if beliefs[\"P_gain\"] >= 0.60: return \"APPROVED\"\n","        if beliefs[\"P_zero\"] >= 0.60: return \"VETO_ZERO_GAIN\"\n","\n","        # شکاف دانش عمیق: امتناع معرفتی\n","        if sigma_pred > 0.50 or max(beliefs.values()) < 0.45:\n","            return \"VETO_EPISTEMIC\"\n","\n","        best_class = max(beliefs, key=beliefs.get)\n","        if best_class == \"P_gain\": return \"APPROVED\"\n","        if best_class == \"P_hazard\": return \"VETO_HAZARD\"\n","        return \"VETO_ZERO_GAIN\"\n","\n","    sweep_records = []\n","\n","    for n_level in noise_sweep_levels:\n","        level_results = []\n","\n","        for item in final_ood_eval_suite:\n","            target = item[\"target\"]\n","            desc = item[\"desc\"]\n","            ctx = item[\"ctx\"]\n","            items = corpus[ctx]\n","\n","            scm = RigorousBayesianSelfGraph(prior_variance=0.5, base_aleatoric=0.005, extrap_penalty_gamma=1.5)\n","            engine = ThreeTierEpistemicEngine(scm, calibrator, lambda_risk=1.0, cost_factor=0.005)\n","\n","            executed_doses, incurred_risk = [], 0.0\n","            stop_reason = \"STOP_MAX_BUDGET\"\n","            final_ep_state = \"EPISTEMICALLY_UNCERTAIN\"\n","\n","            for _ in range(3):\n","                d, should_stop, ep_state, reason, beliefs = engine.evaluate_step(target, ctx, executed_doses)\n","                final_ep_state = ep_state\n","                if should_stop:\n","                    stop_reason = reason\n","                    break\n","                executed_doses.append(d)\n","                probe = TargetSpec(target.layer, target.component, target.index, keep_ratio=1.0 - d)\n","                obs = sensors.measure_grounded_outcomes(items, targets=[probe], noise_sigma=n_level)\n","                incurred_risk += max(0.0, -obs)\n","                scm.update(target.key, ctx, d, obs)\n","\n","            pred_mu, sig_pred, sig_epi, sig_ale = scm.predict([target], ctx)\n","            cal_beliefs = calibrator.predict_beliefs(pred_mu, sig_pred, sig_epi, sig_ale)\n","\n","            # محاسبه باور خام برای مقایسه مستقیم\n","            p_haz_raw = float(norm.cdf((DecoupledUtility.THRESH_HAZARD - pred_mu) / max(sig_pred, 1e-6)))\n","            p_gain_raw = float(1.0 - norm.cdf((DecoupledUtility.THRESH_GAIN - pred_mu) / max(sig_pred, 1e-6)))\n","            p_zero_raw = max(0.0, 1.0 - p_haz_raw - p_gain_raw)\n","            raw_beliefs = {\"P_gain\": p_gain_raw, \"P_zero\": p_zero_raw, \"P_hazard\": p_haz_raw}\n","\n","            gt_delta = sensors.measure_grounded_outcomes(items, targets=[target], noise_sigma=0.0)\n","            oracle_action, oracle_u = DecoupledUtility.get_omniscient_oracle(gt_delta)\n","\n","            verdict = resolve_governor(pred_mu, sig_pred, cal_beliefs, stop_reason)\n","            u = DecoupledUtility.get_utility(verdict, gt_delta)\n","            regret = oracle_u - u\n","\n","            # بردار وان-هات\n","            true_vec = np.zeros(3)\n","            if gt_delta >= DecoupledUtility.THRESH_GAIN: true_vec[0] = 1.0\n","            elif gt_delta < DecoupledUtility.THRESH_HAZARD: true_vec[2] = 1.0\n","            else: true_vec[1] = 1.0\n","\n","            cal_vec = np.array([cal_beliefs[\"P_gain\"], cal_beliefs[\"P_zero\"], cal_beliefs[\"P_hazard\"]])\n","            raw_vec = np.array([raw_beliefs[\"P_gain\"], raw_beliefs[\"P_zero\"], raw_beliefs[\"P_hazard\"]])\n","\n","            cal_brier = float(np.sum((cal_vec - true_vec) ** 2))\n","            raw_brier = float(np.sum((raw_vec - true_vec) ** 2))\n","            unif_brier = float(np.sum((np.array([1/3, 1/3, 1/3]) - true_vec) ** 2))\n","            emp_brier = float(np.sum((emp_prior - true_vec) ** 2))\n","\n","            in_2sigma = (pred_mu - 1.96 * sig_pred) <= gt_delta <= (pred_mu + 1.96 * sig_pred)\n","            interval_width = float(3.92 * sig_pred)\n","\n","            level_results.append({\n","                \"noise\": n_level,\n","                \"target\": target.key,\n","                \"desc\": desc,\n","                \"gt_delta\": gt_delta,\n","                \"oracle\": oracle_action,\n","                \"verdict\": verdict,\n","                \"doses\": executed_doses,\n","                \"steps\": len(executed_doses),\n","                \"risk\": incurred_risk,\n","                \"regret\": regret,\n","                \"epistemic_state\": final_ep_state,\n","                \"stop_reason\": stop_reason,\n","                \"in_2sigma\": in_2sigma,\n","                \"miw\": interval_width,\n","                \"sig_pred\": sig_pred,\n","                \"sig_epi\": sig_epi,\n","                \"sig_ale\": sig_ale,\n","                \"cal_brier\": cal_brier,\n","                \"raw_brier\": raw_brier,\n","                \"unif_brier\": unif_brier,\n","                \"emp_brier\": emp_brier,\n","                \"P_gain\": cal_beliefs[\"P_gain\"],\n","                \"P_zero\": cal_beliefs[\"P_zero\"],\n","                \"P_hazard\": cal_beliefs[\"P_hazard\"]\n","            })\n","\n","        cov_rate = sum(1 for r in level_results if r[\"in_2sigma\"]) / len(level_results) * 100.0\n","        avg_cal_brier = float(np.mean([r[\"cal_brier\"] for r in level_results]))\n","        avg_raw_brier = float(np.mean([r[\"raw_brier\"] for r in level_results]))\n","        avg_unif_brier = float(np.mean([r[\"unif_brier\"] for r in level_results]))\n","        avg_emp_brier = float(np.mean([r[\"emp_brier\"] for r in level_results]))\n","        avg_miw = float(np.mean([r[\"miw\"] for r in level_results]))\n","        tot_risk = sum(r[\"risk\"] for r in level_results)\n","        tot_regret = sum(r[\"regret\"] for r in level_results)\n","\n","        haz_targets = [r for r in level_results if r[\"oracle\"] == \"VETO_HAZARD\"]\n","        sfr = (sum(1 for r in haz_targets if r[\"verdict\"] == \"APPROVED\") / len(haz_targets) * 100.0) if haz_targets else 0.0\n","\n","        gain_targets = [r for r in level_results if r[\"oracle\"] == \"APPROVED\"]\n","        olr = (sum(1 for r in gain_targets if \"VETO\" in r[\"verdict\"]) / len(gain_targets) * 100.0) if gain_targets else 0.0\n","\n","        print(f\"📊 NOISE: {n_level:5.3f} | 2σ: {cov_rate:5.1f}% | MIW: {avg_miw:.3f} | CalBrier: {avg_cal_brier:6.4f} (Raw: {avg_raw_brier:6.4f} | Unif: {avg_unif_brier:6.4f}) | SFR: {sfr:4.1f}% | OLR: {olr:5.1f}% | Regret: {tot_regret:6.4f}\")\n","        sweep_records.extend(level_results)\n","\n","    with open(\"m17_13_empirical_calibration_results.json\", \"w\", encoding=\"utf-8\") as f:\n","        json.dump(to_jsonable(sweep_records), f, indent=2)\n","    print(\"\\n📁 Empirical calibration audit successfully exported to 'm17_13_empirical_calibration_results.json'.\")\n","\n","\n","if __name__ == \"__main__\":\n","    run_milestone_17_13()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":503,"referenced_widgets":["1958bdd113754043a68368cef86b64fb","ad63759ca8b14b3ba24c94955d52ffd7","514e1d74d1cc444a96cf8410e8fbac81","6e67a33eaad74602a64f946441d4a24b","81cbb73cb8924852bca0bec860bb70ee","ad1dddedadd647539a2be3ce5a8383fd","50169495ecc547f8943ae46d37ea19a3","7a7c681822b14dd28300d570d14b9b6a","8ae530e95bcf4279bb8eed95bfb6acd8","c2384e901593463da9f22f9f1b1fbf8f","4df376af95fc4966bc1873278857de26"]},"id":"LoC0PQoMYflf","executionInfo":{"status":"ok","timestamp":1788206032273,"user_tz":420,"elapsed":37074,"user":{"displayName":"Mori Derakhshan","userId":"14048780597071502788"}},"outputId":"f3e8f15b-3b87-46f8-82a2-92539b585df4"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["🔄 Initializing Sensors (Qwen/Qwen2.5-0.5B) on CUDA...\n"]},{"output_type":"display_data","data":{"text/plain":["Loading weights:   0%|          | 0/290 [00:00<?, ?it/s]"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"1958bdd113754043a68368cef86b64fb"}},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Loaded pretrained model Qwen/Qwen2.5-0.5B into HookedTransformer\n","\n","===================================================================================================================================================================================================\n","🔬 MILESTONE 17.13: EMPIRICAL CALIBRATION, EXTRAPOLATION AUDIT & SAFE RECOVERY\n","   Protocol: Phase 1 (Collect Real Memory) -> Phase 2 (Train Empirical Calibrator) -> Phase 3 (Strict Held-Out OOD Test)\n","===================================================================================================================================================================================================\n","\n","📦 PHASE 1: Harvesting Empirical Memory on Calibration Pool...\n","  • Ingested Memory: L20_mlp_0  | Pred μ: -0.6234 | σ_pred: 1.2232 | Ground Truth: -0.5996\n","  • Ingested Memory: L22_head_0 | Pred μ: +0.1357 | σ_pred: 1.2232 | Ground Truth: +0.1299\n","  • Ingested Memory: L8_head_4  | Pred μ: +0.0078 | σ_pred: 1.2232 | Ground Truth: +0.0035\n","  • Ingested Memory: L4_head_0  | Pred μ: -0.0107 | σ_pred: 1.2232 | Ground Truth: -0.0021\n","  • Ingested Memory: L21_head_2 | Pred μ: +0.0359 | σ_pred: 1.2232 | Ground Truth: +0.0590\n","📦 PHASE 2: Empirical Calibrator Training Status: ✅ SUCCESS\n","\n","📦 PHASE 3: Strictly Blind Evaluation on Held-Out OOD Targets...\n","📊 NOISE: 0.000 | 2σ: 100.0% | MIW: 4.779 | CalBrier: 0.6238 (Raw: 0.8421 | Unif: 0.6667) | SFR:  0.0% | OLR: 100.0% | Regret: 0.1493\n","📊 NOISE: 0.005 | 2σ: 100.0% | MIW: 5.341 | CalBrier: 0.6234 (Raw: 0.8487 | Unif: 0.6667) | SFR:  0.0% | OLR: 100.0% | Regret: 0.1493\n","📊 NOISE: 0.010 | 2σ: 100.0% | MIW: 4.779 | CalBrier: 0.6232 (Raw: 0.8389 | Unif: 0.6667) | SFR:  0.0% | OLR: 100.0% | Regret: 0.1493\n","📊 NOISE: 0.020 | 2σ: 100.0% | MIW: 4.779 | CalBrier: 0.6203 (Raw: 0.8486 | Unif: 0.6667) | SFR:  0.0% | OLR: 100.0% | Regret: 0.1493\n","📊 NOISE: 0.040 | 2σ: 100.0% | MIW: 4.779 | CalBrier: 0.6133 (Raw: 0.8295 | Unif: 0.6667) | SFR:  0.0% | OLR: 100.0% | Regret: 0.1493\n","📊 NOISE: 0.080 | 2σ: 100.0% | MIW: 4.779 | CalBrier: 0.6311 (Raw: 0.8987 | Unif: 0.6667) | SFR:  0.0% | OLR: 100.0% | Regret: 0.1493\n","\n","📁 Empirical calibration audit successfully exported to 'm17_13_empirical_calibration_results.json'.\n"]}]},{"cell_type":"code","source":["import torch\n","import numpy as np\n","import json\n","import warnings\n","from dataclasses import dataclass, asdict\n","from typing import Dict, List, Tuple, Optional, Any\n","from scipy.stats import norm\n","from sklearn.linear_model import LogisticRegression\n","from sklearn.isotonic import IsotonicRegression\n","from transformer_lens import HookedTransformer\n","\n","warnings.filterwarnings(\"ignore\", category=UserWarning)\n","\n","SEED = 42\n","torch.manual_seed(SEED)\n","np.random.seed(SEED)\n","\n","MODEL_NAME = \"Qwen/Qwen2.5-0.5B\"\n","\n","\n","# ==============================================================================\n","# 0. SERIALIZATION & HELPERS\n","# ==============================================================================\n","\n","def to_jsonable(obj: Any) -> Any:\n","    if isinstance(obj, dict): return {str(k): to_jsonable(v) for k, v in obj.items()}\n","    if isinstance(obj, (list, tuple)): return [to_jsonable(v) for v in obj]\n","    if isinstance(obj, np.ndarray): return obj.tolist()\n","    if isinstance(obj, np.generic): return obj.item()\n","    if isinstance(obj, torch.Tensor): return obj.item() if obj.ndim == 0 else obj.detach().cpu().tolist()\n","    if isinstance(obj, (str, int, float, bool)) or obj is None: return obj\n","    if hasattr(obj, \"__dataclass_fields__\"): return to_jsonable(asdict(obj))\n","    return str(obj)\n","\n","\n","def extract_context_family(ctx_str: str) -> str:\n","    for prefix in [\"train_\", \"calib_\", \"test_\", \"ood_\"]:\n","        if ctx_str.startswith(prefix): return ctx_str[len(prefix):]\n","    return ctx_str\n","\n","\n","# ==============================================================================\n","# 1. UTILITY MATRIX & GOVERNANCE ONTOLOGY\n","# ==============================================================================\n","\n","class DecoupledUtility:\n","    THRESH_GAIN = 0.005\n","    THRESH_HAZARD = -0.05\n","    ALL_ACTIONS = [\"APPROVED\", \"VETO_ZERO_GAIN\", \"VETO_HAZARD\", \"VETO_EPISTEMIC\"]\n","\n","    @staticmethod\n","    def get_utility(action: str, delta_m: float) -> float:\n","        if delta_m >= DecoupledUtility.THRESH_GAIN:\n","            if action == \"APPROVED\": return float(delta_m)\n","            if action == \"VETO_EPISTEMIC\": return -0.005\n","            if action == \"VETO_ZERO_GAIN\": return -0.015\n","            if action == \"VETO_HAZARD\": return -0.03\n","        elif delta_m < DecoupledUtility.THRESH_HAZARD:\n","            if action == \"VETO_HAZARD\": return 0.05\n","            if action == \"VETO_EPISTEMIC\": return 0.03\n","            if action == \"VETO_ZERO_GAIN\": return 0.01\n","            if action == \"APPROVED\": return float(10.0 * delta_m)\n","        else:\n","            if action == \"VETO_ZERO_GAIN\": return 0.005\n","            if action == \"VETO_EPISTEMIC\": return 0.002\n","            if action == \"VETO_HAZARD\": return 0.0\n","            if action == \"APPROVED\": return float(delta_m)\n","        return -1.0\n","\n","    @staticmethod\n","    def get_omniscient_oracle(delta_m: float) -> Tuple[str, float]:\n","        utils = [DecoupledUtility.get_utility(a, delta_m) for a in DecoupledUtility.ALL_ACTIONS]\n","        best_idx = int(np.argmax(utils))\n","        return DecoupledUtility.ALL_ACTIONS[best_idx], utils[best_idx]\n","\n","\n","# ==============================================================================\n","# 2. BAYESIAN SCM: TRI-DECOMPOSITION (EPISTEMIC, ALEATORIC, EXTRAPOLATION)\n","# ==============================================================================\n","\n","@dataclass\n","class TargetSpec:\n","    layer: int\n","    component: str\n","    index: int = 0\n","    keep_ratio: float = 0.0\n","\n","    @property\n","    def dose(self) -> float:\n","        return float(np.clip(1.0 - self.keep_ratio, 0.0, 1.0))\n","\n","    @property\n","    def key(self) -> str:\n","        return f\"L{self.layer}_{self.component}_{self.index}\"\n","\n","\n","@dataclass\n","class PromptItem:\n","    prompt: str\n","    target_str: str\n","    distractor_str: str\n","\n","\n","class TriDecomposedBayesianSelfGraph:\n","    def __init__(self, prior_variance: float = 0.5, base_aleatoric: float = 0.005):\n","        self.prior_variance = prior_variance\n","        self.base_aleatoric = base_aleatoric\n","        self.component_models: Dict[str, Dict[str, Dict[str, Any]]] = {}\n","\n","    def init_node(self, target_key: str, ctx_str: str):\n","        family = extract_context_family(ctx_str)\n","        if target_key not in self.component_models:\n","            self.component_models[target_key] = {}\n","        if family not in self.component_models[target_key]:\n","            self.component_models[target_key][family] = {\n","                \"mu\": np.zeros(2),\n","                \"precision\": np.eye(2) / self.prior_variance,\n","                \"cov\": np.eye(2) * self.prior_variance,\n","                \"aleatoric_var\": self.base_aleatoric,\n","                \"history\": [],\n","                \"max_dose_probed\": 0.0,\n","                \"n\": 0\n","            }\n","\n","    def update(self, target_key: str, ctx_str: str, dose: float, delta_obs: float):\n","        family = extract_context_family(ctx_str)\n","        self.init_node(target_key, ctx_str)\n","        node = self.component_models[target_key][family]\n","\n","        x = np.array([dose, dose**2])\n","        node[\"history\"].append((dose, delta_obs))\n","        node[\"max_dose_probed\"] = max(node[\"max_dose_probed\"], dose)\n","\n","        if len(node[\"history\"]) >= 3:\n","            y_vals = np.array([h[1] for h in node[\"history\"]])\n","            diffs = np.diff(y_vals)\n","            est_noise_var = float(0.5 * np.mean(diffs**2))\n","            node[\"aleatoric_var\"] = max(self.base_aleatoric, est_noise_var)\n","\n","        inv_noise = 1.0 / max(node[\"aleatoric_var\"], 1e-6)\n","        prec_old = node[\"precision\"]\n","        mu_old = node[\"mu\"]\n","\n","        prec_new = prec_old + inv_noise * np.outer(x, x)\n","        cov_new = np.linalg.inv(prec_new)\n","        mu_new = cov_new @ (prec_old @ mu_old + inv_noise * x * delta_obs)\n","\n","        node[\"precision\"] = prec_new\n","        node[\"cov\"] = cov_new\n","        node[\"mu\"] = mu_new\n","        node[\"n\"] += 1\n","\n","    def predict_tri_decomposition(self, targets: List[TargetSpec], ctx_str: str) -> Tuple[float, float, float, float, float]:\n","        \"\"\"\n","        خروجی صریح ۵ بخشی:\n","        (میانگین پیش‌بینی، انحراف کل، واریانس معرفتی خالص، واریانس آلاتوریک، واریانس برون‌یابی)\n","        \"\"\"\n","        family = extract_context_family(ctx_str)\n","        pred_delta = 0.0\n","        var_epi = 0.0\n","        var_ale = 0.0\n","        var_extrap = 0.0\n","\n","        for t in targets:\n","            if t.dose == 0.0: continue\n","            self.init_node(t.key, ctx_str)\n","            node = self.component_models[t.key][family]\n","            x_target = np.array([t.dose, t.dose**2])\n","            pred_delta += float(x_target @ node[\"mu\"])\n","\n","            # دوز حداکثر پروب‌شده به عنوان مرز داده مطمئن\n","            d_max = max(node[\"max_dose_probed\"], 0.05)\n","            x_safe = np.array([min(t.dose, d_max), min(t.dose, d_max)**2])\n","\n","            # ۱. واریانس معرفتی پارامترها درون دامنه پروب\n","            v_epi = float(x_safe @ node[\"cov\"] @ x_safe)\n","            var_epi += v_epi\n","\n","            # ۲. واریانس آلاتوریک\n","            var_ale += float(node[\"aleatoric_var\"])\n","\n","            # ۳. واریانس برون‌یابی مجزا بر حسب فاصله از سقف پروب\n","            if t.dose > d_max:\n","                extrap_distance = t.dose - d_max\n","                cov_trace = float(np.trace(node[\"cov\"]))\n","                v_extrap = (extrap_distance ** 2) * (cov_trace * 10.0)\n","                var_extrap += v_extrap\n","\n","        total_var = var_epi + var_ale + var_extrap\n","        return pred_delta, float(np.sqrt(total_var)), float(np.sqrt(var_epi)), float(np.sqrt(var_ale)), float(np.sqrt(var_extrap))\n","\n","\n","# ==============================================================================\n","# 3. SCALED EMPIRICAL CALIBRATOR (TRAINED ON N >= 20 DATA)\n","# ==============================================================================\n","\n","class ScaledEmpiricalCalibrator:\n","    def __init__(self):\n","        self.model = LogisticRegression(multi_class=\"multinomial\", solver=\"lbfgs\", max_iter=300, C=0.5)\n","        self.is_fitted = False\n","        self.features: List[np.ndarray] = []\n","        self.labels: List[int] = []\n","\n","    @staticmethod\n","    def extract_vector(mu: float, sig_pred: float, sig_epi: float, sig_extrap: float) -> np.ndarray:\n","        sig_pred = max(sig_pred, 1e-6)\n","        z_gain = (mu - DecoupledUtility.THRESH_GAIN) / sig_pred\n","        z_haz = (DecoupledUtility.THRESH_HAZARD - mu) / sig_pred\n","        return np.array([mu, sig_pred, sig_epi, sig_extrap, z_gain, z_haz])\n","\n","    def store_sample(self, mu: float, sig_pred: float, sig_epi: float, sig_extrap: float, true_delta: float):\n","        vec = self.extract_vector(mu, sig_pred, sig_epi, sig_extrap)\n","        if true_delta >= DecoupledUtility.THRESH_GAIN: y = 0\n","        elif true_delta < DecoupledUtility.THRESH_HAZARD: y = 2\n","        else: y = 1\n","        self.features.append(vec)\n","        self.labels.append(y)\n","\n","    def train_calibrator(self) -> bool:\n","        if len(self.labels) < 12 or len(set(self.labels)) < 3:\n","            self.is_fitted = False\n","            return False\n","        X = np.array(self.features)\n","        y = np.array(self.labels)\n","        self.model.fit(X, y)\n","        self.is_fitted = True\n","        return True\n","\n","    def predict_beliefs(self, mu: float, sig_pred: float, sig_epi: float, sig_extrap: float) -> Dict[str, float]:\n","        sig_pred = max(sig_pred, 1e-6)\n","        if not self.is_fitted:\n","            p_haz = float(norm.cdf((DecoupledUtility.THRESH_HAZARD - mu) / sig_pred))\n","            p_gain = float(1.0 - norm.cdf((DecoupledUtility.THRESH_GAIN - mu) / sig_pred))\n","            p_zero = max(0.0, 1.0 - p_haz - p_gain)\n","            return {\"P_gain\": p_gain, \"P_zero\": p_zero, \"P_hazard\": p_haz}\n","\n","        vec = self.extract_vector(mu, sig_pred, sig_epi, sig_extrap).reshape(1, -1)\n","        probs = self.model.predict_proba(vec)[0]\n","        classes = self.model.classes_\n","\n","        p_gain = float(probs[np.where(classes == 0)[0][0]]) if 0 in classes else 0.0\n","        p_zero = float(probs[np.where(classes == 1)[0][0]]) if 1 in classes else 0.0\n","        p_hazard = float(probs[np.where(classes == 2)[0][0]]) if 2 in classes else 0.0\n","\n","        total = p_gain + p_zero + p_hazard\n","        if total <= 0: total = 1.0\n","        return {\"P_gain\": p_gain / total, \"P_zero\": p_zero / total, \"P_hazard\": p_hazard / total}\n","\n","\n","# ==============================================================================\n","# 4. MECHANISTIC SENSORS INTERFACE\n","# ==============================================================================\n","\n","class MechanisticSensorInterface:\n","    def __init__(self, model_name: str = MODEL_NAME, device: str = \"cuda\"):\n","        self.device = device if torch.cuda.is_available() else \"cpu\"\n","        print(f\"🔄 Initializing Sensors ({model_name}) on {self.device.upper()}...\")\n","        self.model = HookedTransformer.from_pretrained(\n","            model_name, device=self.device, torch_dtype=torch.float32, default_padding_side=\"left\"\n","        )\n","        self.model.eval()\n","        for p in self.model.parameters(): p.requires_grad_(False)\n","\n","    def _build_hooks(self, targets: List[TargetSpec]):\n","        hooks = []\n","        for t in targets:\n","            keep = t.keep_ratio\n","            if t.component == \"head\":\n","                h_idx = t.index\n","                def head_hook_fn(act, hook, h=h_idx, r=keep):\n","                    act[:, -1, h, :] = act[:, -1, h, :] * r\n","                    return act\n","                hooks.append((f\"blocks.{t.layer}.attn.hook_z\", head_hook_fn))\n","            elif t.component == \"mlp\":\n","                def mlp_hook_fn(act, hook, r=keep):\n","                    act[:, -1, :] = act[:, -1, :] * r\n","                    return act\n","                hooks.append((f\"blocks.{t.layer}.hook_mlp_out\", mlp_hook_fn))\n","        return hooks\n","\n","    def _resolve_token_id(self, token_str: str) -> int:\n","        toks = self.model.to_tokens(token_str, prepend_bos=False)[0]\n","        return int(toks[-1].item())\n","\n","    @torch.no_grad()\n","    def measure_grounded_outcomes(\n","        self, items: List[PromptItem], targets: Optional[List[TargetSpec]] = None, noise_sigma: float = 0.0\n","    ) -> float:\n","        prompts = [it.prompt for it in items]\n","        tokens = self.model.to_tokens(prompts)\n","        batch_size = len(items)\n","        b_idx = torch.arange(batch_size, device=self.device)\n","\n","        target_ids = torch.tensor([self._resolve_token_id(it.target_str) for it in items], device=self.device)\n","        distractor_ids = torch.tensor([self._resolve_token_id(it.distractor_str) for it in items], device=self.device)\n","\n","        clean_logits = self.model(tokens)[:, -1, :].float()\n","        clean_m = clean_logits[b_idx, target_ids] - clean_logits[b_idx, distractor_ids]\n","\n","        if not targets: return 0.0\n","\n","        with self.model.hooks(fwd_hooks=self._build_hooks(targets)):\n","            int_logits = self.model(tokens)[:, -1, :].float()\n","\n","        int_m = int_logits[b_idx, target_ids] - int_logits[b_idx, distractor_ids]\n","        raw_delta = float(torch.mean(int_m - clean_m).item())\n","\n","        if noise_sigma > 0.0:\n","            return raw_delta + float(np.random.normal(0.0, noise_sigma))\n","        return raw_delta\n","\n","\n","# ==============================================================================\n","# 5. DISENTANGLED PROBE-RISK VS DECISION-RISK ENGINE\n","# ==============================================================================\n","\n","class DisentangledRiskEVoIEngine:\n","    def __init__(self, scm: TriDecomposedBayesianSelfGraph, calibrator: ScaledEmpiricalCalibrator,\n","                 lambda_probe_risk: float = 0.5, cost_factor: float = 0.002):\n","        self.scm = scm\n","        self.calibrator = calibrator\n","        self.lambda_probe_risk = lambda_probe_risk\n","        self.cost_factor = cost_factor\n","        # دوزهای پروبینگ با پوشش بالاتر تا 0.50 برای کاهش برون‌یابی\n","        self.candidates = np.linspace(0.08, 0.48, 6)\n","        self.eval_shifts = np.array([-2.0, -1.5, -1.0, -0.5, 0.0, 0.5, 1.0, 1.5, 2.0])\n","        self.eval_weights = norm.pdf(self.eval_shifts)\n","        self.eval_weights /= np.sum(self.eval_weights)\n","\n","    def _evaluate_max_expected_utility(self, mu_star: float, sigma_star: float) -> float:\n","        sigma_star = max(sigma_star, 1e-6)\n","        samples = mu_star + sigma_star * self.eval_shifts\n","        action_expected_utils = []\n","        for a in DecoupledUtility.ALL_ACTIONS:\n","            eu_a = sum(w * DecoupledUtility.get_utility(a, s) for w, s in zip(self.eval_weights, samples))\n","            action_expected_utils.append(eu_a)\n","        return float(max(action_expected_utils))\n","\n","    def evaluate_step(\n","        self, target: TargetSpec, ctx_str: str, executed_doses: List[float]\n","    ) -> Tuple[float, bool, str, str, Dict[str, float]]:\n","        self.scm.init_node(target.key, ctx_str)\n","        node = self.scm.component_models[target.key][extract_context_family(ctx_str)]\n","\n","        pred_mu, sig_pred, sig_epi, sig_ale, sig_extrap = self.scm.predict_tri_decomposition([target], ctx_str)\n","        beliefs = self.calibrator.predict_beliefs(pred_mu, sig_pred, sig_epi, sig_extrap)\n","\n","        # ۱. وضعیت پایش شناخت\n","        epistemic_state = \"EPISTEMICALLY_UNCERTAIN\"\n","        if beliefs[\"P_hazard\"] >= 0.60:\n","            epistemic_state = \"CONFIDENT_HAZARD\"\n","        elif beliefs[\"P_gain\"] >= 0.60:\n","            epistemic_state = \"CONFIDENT_GAIN\"\n","        elif beliefs[\"P_zero\"] >= 0.60:\n","            epistemic_state = \"CONFIDENT_ZERO_GAIN\"\n","\n","        if len(executed_doses) >= 1 and epistemic_state != \"EPISTEMICALLY_UNCERTAIN\":\n","            return 0.0, True, epistemic_state, f\"STOP_{epistemic_state}\", beliefs\n","\n","        # ۲. ارزش اقتصادی با تفکیک صریح ریسک پروبینگ موضعی\n","        current_v = self._evaluate_max_expected_utility(pred_mu, sig_pred)\n","        best_net_score = -float(\"inf\")\n","        best_dose = self.candidates[0]\n","\n","        pts, wts = np.polynomial.hermite.hermgauss(5)\n","\n","        for d in self.candidates:\n","            if any(abs(d - ed) < 0.04 for ed in executed_doses): continue\n","            x_d = np.array([d, d**2])\n","            pred_y = float(x_d @ node[\"mu\"])\n","            std_y = np.sqrt(float(x_d @ node[\"cov\"] @ x_d) + node[\"aleatoric_var\"])\n","\n","            prec_sim = node[\"precision\"] + (1.0 / node[\"aleatoric_var\"]) * np.outer(x_d, x_d)\n","            cov_sim = np.linalg.inv(prec_sim)\n","\n","            # شبیه‌سازی کاهش عدم قطعیت\n","            d_max_sim = max(node[\"max_dose_probed\"], d)\n","            x_safe_sim = np.array([min(1.0, d_max_sim), min(1.0, d_max_sim)**2])\n","            epi_sim = float(x_safe_sim @ cov_sim @ x_safe_sim)\n","            extrap_sim = ((1.0 - d_max_sim) ** 2) * (float(np.trace(cov_sim)) * 10.0)\n","            sig_pred_sim = float(np.sqrt(epi_sim + node[\"aleatoric_var\"] + extrap_sim))\n","\n","            expected_posterior_v = 0.0\n","            probe_harm_expected = 0.0\n","            for pt, w in zip(pts, wts):\n","                y_sample = pred_y + np.sqrt(2.0) * std_y * pt\n","                mu_sim = cov_sim @ (node[\"precision\"] @ node[\"mu\"] + (1.0 / node[\"aleatoric_var\"]) * x_d * y_sample)\n","                mu_full_sim = float(np.array([1.0, 1.0]) @ mu_sim)\n","                expected_posterior_v += (w / np.sqrt(np.pi)) * self._evaluate_max_expected_utility(mu_full_sim, sig_pred_sim)\n","                # ریسک فقط مختص آسیب فیزیکی دوز پروبینگ است\n","                probe_harm_expected += (w / np.sqrt(np.pi)) * max(0.0, -y_sample)\n","\n","            evoi = max(0.0, expected_posterior_v - current_v)\n","            net_score = evoi - (self.cost_factor * float(d**2)) - (self.lambda_probe_risk * probe_harm_expected)\n","\n","            if net_score > best_net_score:\n","                best_net_score = net_score\n","                best_dose = float(d)\n","\n","        if len(executed_doses) >= 2 and best_net_score <= 0.0:\n","            return 0.0, True, epistemic_state, \"STOP_UNECONOMIC\", beliefs\n","\n","        return best_dose, False, epistemic_state, \"CONTINUE_PROBING\", beliefs\n","\n","\n","# ==============================================================================\n","# 6. PROTOCOL CONTROLLER (MILESTONE 17.14)\n","# ==============================================================================\n","\n","def run_milestone_17_14():\n","    sensors = MechanisticSensorInterface()\n","\n","    corpus = {\n","        \"ood_syntactic_agreement\": [\n","            PromptItem(\"The keys to the cabinet are kept in the\", \" drawer\", \" drawers\"),\n","            PromptItem(\"The books on the wooden table belong to the\", \" library\", \" libraries\"),\n","            PromptItem(\"The pictures of the old palace show the ancient\", \" king\", \" kings\"),\n","            PromptItem(\"The report about the recent discoveries was presented by\", \" researcher\", \" researchers\"),\n","        ],\n","        \"ood_distractor_reasoning\": [\n","            PromptItem(\"While Rome has the Colosseum, the Eiffel Tower stands in\", \" Paris\", \" Rome\"),\n","            PromptItem(\"Even though Madrid is famous, the capital of Germany is\", \" Berlin\", \" Madrid\"),\n","            PromptItem(\"Egypt has pyramids, but the Eiffel Tower was built in the city of\", \" Paris\", \" Cairo\"),\n","        ],\n","        \"train_factual_cap\": [\n","            PromptItem(\"The capital of France is the city of\", \" Paris\", \" Rome\"),\n","            PromptItem(\"The capital of Japan is the bustling city of\", \" Tokyo\", \" Kyoto\"),\n","            PromptItem(\"The official capital city of Germany is\", \" Berlin\", \" Munich\"),\n","            PromptItem(\"The historic capital of Italy is the city of\", \" Rome\", \" Milan\"),\n","        ]\n","    }\n","\n","    # استخر مقیاس‌یافته کالیبراسیون (۱۵ گره متنوع برای آموزش مطمئن)\n","    calibration_pool_scaled = [\n","        # رژیم Hazard\n","        {\"desc\": \"L20 MLP\", \"target\": TargetSpec(20, \"mlp\", 0, keep_ratio=0.0), \"ctx\": \"ood_syntactic_agreement\"},\n","        {\"desc\": \"L19 MLP\", \"target\": TargetSpec(19, \"mlp\", 0, keep_ratio=0.0), \"ctx\": \"ood_syntactic_agreement\"},\n","        {\"desc\": \"L18 MLP\", \"target\": TargetSpec(18, \"mlp\", 0, keep_ratio=0.0), \"ctx\": \"ood_syntactic_agreement\"},\n","        {\"desc\": \"L21 MLP\", \"target\": TargetSpec(21, \"mlp\", 0, keep_ratio=0.0), \"ctx\": \"ood_syntactic_agreement\"},\n","        {\"desc\": \"L12 MLP\", \"target\": TargetSpec(12, \"mlp\", 0, keep_ratio=0.0), \"ctx\": \"train_factual_cap\"},\n","        # رژیم Zero-Gain\n","        {\"desc\": \"L4 Head 0\", \"target\": TargetSpec(4, \"head\", 0, keep_ratio=0.0), \"ctx\": \"ood_syntactic_agreement\"},\n","        {\"desc\": \"L2 Head 1\", \"target\": TargetSpec(2, \"head\", 1, keep_ratio=0.0), \"ctx\": \"ood_syntactic_agreement\"},\n","        {\"desc\": \"L8 Head 4\", \"target\": TargetSpec(8, \"head\", 4, keep_ratio=0.0), \"ctx\": \"ood_syntactic_agreement\"},\n","        {\"desc\": \"L1 Head 0\", \"target\": TargetSpec(1, \"head\", 0, keep_ratio=0.0), \"ctx\": \"train_factual_cap\"},\n","        {\"desc\": \"L6 Head 2\", \"target\": TargetSpec(6, \"head\", 2, keep_ratio=0.0), \"ctx\": \"train_factual_cap\"},\n","        # رژیم Positive Gain\n","        {\"desc\": \"L22 Head 0\", \"target\": TargetSpec(22, \"head\", 0, keep_ratio=0.0), \"ctx\": \"train_factual_cap\"},\n","        {\"desc\": \"L4 Head 0 (Distract)\", \"target\": TargetSpec(4, \"head\", 0, keep_ratio=0.0), \"ctx\": \"ood_distractor_reasoning\"},\n","        {\"desc\": \"L16 MLP\", \"target\": TargetSpec(16, \"mlp\", 0, keep_ratio=0.0), \"ctx\": \"ood_syntactic_agreement\"},\n","        {\"desc\": \"L21 Head 2\", \"target\": TargetSpec(21, \"head\", 2, keep_ratio=0.0), \"ctx\": \"train_factual_cap\"},\n","        {\"desc\": \"L23 Head 1\", \"target\": TargetSpec(23, \"head\", 1, keep_ratio=0.0), \"ctx\": \"train_factual_cap\"}\n","    ]\n","\n","    # گره‌های ارزیابی نهایی Held-Out\n","    final_ood_suite = [\n","        {\"desc\": \"HeldOut Medium Hazard L12MLP\", \"target\": TargetSpec(12, \"mlp\", 0, keep_ratio=0.0), \"ctx\": \"ood_syntactic_agreement\"},\n","        {\"desc\": \"HeldOut Boundary L12H3\", \"target\": TargetSpec(12, \"head\", 3, keep_ratio=0.0), \"ctx\": \"ood_syntactic_agreement\"},\n","        {\"desc\": \"HeldOut Neutral L3H2\", \"target\": TargetSpec(3, \"head\", 2, keep_ratio=0.0), \"ctx\": \"ood_syntactic_agreement\"},\n","        {\"desc\": \"HeldOut Gain L15MLP\", \"target\": TargetSpec(15, \"mlp\", 0, keep_ratio=0.0), \"ctx\": \"ood_distractor_reasoning\"},\n","        {\"desc\": \"HeldOut Positive L20H1\", \"target\": TargetSpec(20, \"head\", 1, keep_ratio=0.0), \"ctx\": \"train_factual_cap\"}\n","    ]\n","\n","    print(\"\\n\" + \"=\" * 195)\n","    print(\"🔬 MILESTONE 17.14: CALIBRATION SCALING & UNCERTAINTY TRI-DECOMPOSITION AUDIT\")\n","    print(\"   Protocol: Scaled Memory (N=15) -> Tri-Decomposition (Epi, Ale, Extrap) -> Held-Out Test\")\n","    print(\"=\" * 195)\n","\n","    # --------------------------------------------------------------------------\n","    # فاز ۱ و ۲: ساخت حافظه تجربی مقیاس‌یافته و فیت کالیبراتور\n","    # --------------------------------------------------------------------------\n","    print(\"\\n📦 PHASE 1: Harvesting Scaled Empirical Memory (15 Targets)...\")\n","    calibrator = ScaledEmpiricalCalibrator()\n","\n","    for item in calibration_pool_scaled:\n","        target = item[\"target\"]\n","        ctx = item[\"ctx\"]\n","        items = corpus[ctx]\n","        scm = TriDecomposedBayesianSelfGraph(prior_variance=0.5, base_aleatoric=0.005)\n","\n","        for d in [0.10, 0.25, 0.40]:\n","            probe = TargetSpec(target.layer, target.component, target.index, keep_ratio=1.0 - d)\n","            obs = sensors.measure_grounded_outcomes(items, targets=[probe], noise_sigma=0.005)\n","            scm.update(target.key, ctx, d, obs)\n","\n","        pred_mu, sig_pred, sig_epi, sig_ale, sig_extrap = scm.predict_tri_decomposition([target], ctx)\n","        true_delta = sensors.measure_grounded_outcomes(items, targets=[target], noise_sigma=0.0)\n","        calibrator.store_sample(pred_mu, sig_pred, sig_epi, sig_extrap, true_delta)\n","        print(f\"  • Ingested: {target.key:<10} | Pred μ: {pred_mu:+7.4f} | σ_pred: {sig_pred:6.4f} (Epi: {sig_epi:.3f}, Extrap: {sig_extrap:.3f}) | GT: {true_delta:+7.4f}\")\n","\n","    trained_ok = calibrator.train_calibrator()\n","    print(f\"📦 PHASE 2: Calibrator Fitting: {'✅ SUCCESS (Multinomial Logistic Trained)' if trained_ok else '⚠️ FALLBACK'}\")\n","\n","    # --------------------------------------------------------------------------\n","    # فاز ۳: ارزیابی Held-Out در سطوح نویز\n","    # --------------------------------------------------------------------------\n","    print(\"\\n📦 PHASE 3: Evaluating Held-Out Suite across Noise Sweep...\")\n","    noise_sweep = [0.0, 0.005, 0.010, 0.020, 0.040, 0.080]\n","    emp_prior = np.array([0.333, 0.400, 0.267])\n","\n","    def resolve_governor(mu: float, sigma_pred: float, beliefs: Dict[str, float]) -> str:\n","        if beliefs[\"P_hazard\"] >= 0.55: return \"VETO_HAZARD\"\n","        if beliefs[\"P_gain\"] >= 0.55: return \"APPROVED\"\n","        if beliefs[\"P_zero\"] >= 0.55: return \"VETO_ZERO_GAIN\"\n","\n","        if sigma_pred > 0.60 or max(beliefs.values()) < 0.45:\n","            return \"VETO_EPISTEMIC\"\n","\n","        best_class = max(beliefs, key=beliefs.get)\n","        if best_class == \"P_gain\": return \"APPROVED\"\n","        if best_class == \"P_hazard\": return \"VETO_HAZARD\"\n","        return \"VETO_ZERO_GAIN\"\n","\n","    sweep_records = []\n","\n","    for n_level in noise_sweep:\n","        level_results = []\n","\n","        for item in final_ood_suite:\n","            target = item[\"target\"]\n","            desc = item[\"desc\"]\n","            ctx = item[\"ctx\"]\n","            items = corpus[ctx]\n","\n","            scm = TriDecomposedBayesianSelfGraph(prior_variance=0.5, base_aleatoric=0.005)\n","            engine = DisentangledRiskEVoIEngine(scm, calibrator, lambda_probe_risk=0.5, cost_factor=0.002)\n","\n","            executed_doses, incurred_risk = [], 0.0\n","            stop_reason = \"STOP_MAX_BUDGET\"\n","            final_ep_state = \"EPISTEMICALLY_UNCERTAIN\"\n","\n","            for _ in range(3):\n","                d, should_stop, ep_state, reason, beliefs = engine.evaluate_step(target, ctx, executed_doses)\n","                final_ep_state = ep_state\n","                if should_stop:\n","                    stop_reason = reason\n","                    break\n","                executed_doses.append(d)\n","                probe = TargetSpec(target.layer, target.component, target.index, keep_ratio=1.0 - d)\n","                obs = sensors.measure_grounded_outcomes(items, targets=[probe], noise_sigma=n_level)\n","                incurred_risk += max(0.0, -obs)\n","                scm.update(target.key, ctx, d, obs)\n","\n","            pred_mu, sig_pred, sig_epi, sig_ale, sig_extrap = scm.predict_tri_decomposition([target], ctx)\n","            cal_beliefs = calibrator.predict_beliefs(pred_mu, sig_pred, sig_epi, sig_extrap)\n","\n","            # باور گوسی خام قبلی\n","            p_haz_raw = float(norm.cdf((DecoupledUtility.THRESH_HAZARD - pred_mu) / max(sig_pred, 1e-6)))\n","            p_gain_raw = float(1.0 - norm.cdf((DecoupledUtility.THRESH_GAIN - pred_mu) / max(sig_pred, 1e-6)))\n","            p_zero_raw = max(0.0, 1.0 - p_haz_raw - p_gain_raw)\n","            raw_beliefs = {\"P_gain\": p_gain_raw, \"P_zero\": p_zero_raw, \"P_hazard\": p_haz_raw}\n","\n","            gt_delta = sensors.measure_grounded_outcomes(items, targets=[target], noise_sigma=0.0)\n","            oracle_action, oracle_u = DecoupledUtility.get_omniscient_oracle(gt_delta)\n","\n","            verdict = resolve_governor(pred_mu, sig_pred, cal_beliefs)\n","            u = DecoupledUtility.get_utility(verdict, gt_delta)\n","            regret = oracle_u - u\n","\n","            true_vec = np.zeros(3)\n","            if gt_delta >= DecoupledUtility.THRESH_GAIN: true_vec[0] = 1.0\n","            elif gt_delta < DecoupledUtility.THRESH_HAZARD: true_vec[2] = 1.0\n","            else: true_vec[1] = 1.0\n","\n","            cal_vec = np.array([cal_beliefs[\"P_gain\"], cal_beliefs[\"P_zero\"], cal_beliefs[\"P_hazard\"]])\n","            raw_vec = np.array([raw_beliefs[\"P_gain\"], raw_beliefs[\"P_zero\"], raw_beliefs[\"P_hazard\"]])\n","\n","            cal_brier = float(np.sum((cal_vec - true_vec) ** 2))\n","            raw_brier = float(np.sum((raw_vec - true_vec) ** 2))\n","            unif_brier = float(np.sum((np.array([1/3, 1/3, 1/3]) - true_vec) ** 2))\n","\n","            in_2sigma = (pred_mu - 1.96 * sig_pred) <= gt_delta <= (pred_mu + 1.96 * sig_pred)\n","            interval_width = float(3.92 * sig_pred)\n","\n","            level_results.append({\n","                \"noise\": n_level,\n","                \"target\": target.key,\n","                \"desc\": desc,\n","                \"gt_delta\": gt_delta,\n","                \"oracle\": oracle_action,\n","                \"verdict\": verdict,\n","                \"doses\": executed_doses,\n","                \"steps\": len(executed_doses),\n","                \"risk\": incurred_risk,\n","                \"regret\": regret,\n","                \"epistemic_state\": final_ep_state,\n","                \"stop_reason\": stop_reason,\n","                \"in_2sigma\": in_2sigma,\n","                \"miw\": interval_width,\n","                \"sig_pred\": sig_pred,\n","                \"sig_epi\": sig_epi,\n","                \"sig_extrap\": sig_extrap,\n","                \"cal_brier\": cal_brier,\n","                \"raw_brier\": raw_brier,\n","                \"unif_brier\": unif_brier,\n","                \"P_gain\": cal_beliefs[\"P_gain\"],\n","                \"P_zero\": cal_beliefs[\"P_zero\"],\n","                \"P_hazard\": cal_beliefs[\"P_hazard\"]\n","            })\n","\n","        cov_rate = sum(1 for r in level_results if r[\"in_2sigma\"]) / len(level_results) * 100.0\n","        avg_cal_brier = float(np.mean([r[\"cal_brier\"] for r in level_results]))\n","        avg_raw_brier = float(np.mean([r[\"raw_brier\"] for r in level_results]))\n","        avg_unif_brier = float(np.mean([r[\"unif_brier\"] for r in level_results]))\n","        avg_miw = float(np.mean([r[\"miw\"] for r in level_results]))\n","        tot_regret = sum(r[\"regret\"] for r in level_results)\n","\n","        ha